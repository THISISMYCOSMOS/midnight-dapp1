# cp .env.example .env.local 후 dev 서버를 (재)시작한다. Vite는 시작 시에만 읽는다.

VITE_NETWORK_ID=preprod

# 읽기 전용으로 둘러보려면 이 값을 그대로 둔다. 공개된 Preprod 데모 계약이다.
# 본인 키로 리뷰를 남기려면 /deploy로 직접 배포한 주소로 바꾼다.
VITE_CONTRACT_ADDRESS=d9643b895605a579f188ae0596c32580f60e6644d1089e713915870f2f6d1ba1

VITE_INDEXER_URI=https://indexer.preprod.midnight.network/api/v4/graphql
VITE_INDEXER_WS_URI=wss://indexer.preprod.midnight.network/api/v4/graphql/ws

VITE_PRODUCT_ID_HEX=
VITE_PRODUCT_NAME=무선 이어폰 XR-200

# 자격자 3명의 비밀키(64자리 hex). 각자 reviewer-tools로 만든 값을 넣는다.
# 비워 두면 브라우저가 임시 난수 키를 만들고, 그 키는 어떤 계약의 자격 트리에도 없으므로
# 화면에 `데모 자격키 0/3` 경고가 뜬다. 읽기 전용으로 볼 때는 비워 둬도 된다.
# 이 파일에는 절대 실제 비밀키를 적지 않는다. .env.local에만 넣는다.
VITE_DEMO_SECRET_1=
VITE_DEMO_SECRET_2=
VITE_DEMO_SECRET_3=
